{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "rootDir": "./src",
    "outDir": "dist"
  },
  "exclude": [
    "dist",
    "scripts"
  ]
}